{
  "name": "@motion/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "mkdir -p ../apps/web/dist && wrangler dev",
    "typecheck": "tsc -p .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply motion --local",
    "deploy": "test -f ../apps/web/dist/index.html && test -f ../apps/web/dist/_headers || { echo 'build the web app first (root: npm run deploy)'; exit 1; }; wrangler deploy",
    "db:migrate:remote": "wrangler d1 migrations apply motion --remote",
    "db:export": "mkdir -p ../backups && wrangler d1 export motion --remote --output ../backups/$(date +%F-%H%M%S).sql",
    "auth:hash": "node scripts/hash-password.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.4.0",
    "@motion/core": "*",
    "chrono-node": "^2.10.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.22",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.2",
    "@cloudflare/workers-types": "^5.20261125.1",
    "drizzle-kit": "^0.31.11",
    "wrangler": "^4.168.0"
  }
}
