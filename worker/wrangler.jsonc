{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "motion",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-20",
  "minify": true,
  // CIMD: the OAuth provider may fetch client-supplied metadata URLs → public internet only (SSRF guard)
  "compatibility_flags": ["global_fetch_strictly_public"],
  // version preview URLs would be a second origin/issuer on the same D1 + KV
  "preview_urls": false,
  "observability": { "enabled": true },
  // Same origin for PWA + API + OAuth (cookie session). Worker-owned paths run before the SPA fallback.
  "assets": {
    "directory": "../apps/web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/mcp/*", "/oauth/*", "/authorize", "/token", "/.well-known/*"]
  },
  // prod values; local dev adds the Inspector origin via .dev.vars (tests: vitest.config bindings)
  "vars": {
    "DEFAULT_TZ": "UTC",
    "OAUTH_REDIRECT_ALLOW": "https://claude.ai,https://claude.com"
  },
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "3042f925a67245c8b2ed1532a0b4606c" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "motion",
      "database_id": "a8d19f38-2fb4-4b21-95a5-71ab664ea830",
      "migrations_dir": "migrations"
    }
  ]
}
