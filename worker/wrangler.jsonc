{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "motion",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-20",
  "minify": true,
  "observability": { "enabled": true },
  // Same origin for PWA + API + OAuth (cookie session). Worker-owned paths run before the SPA fallback.
  "assets": {
    "directory": "../apps/web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/mcp/*", "/oauth/*", "/authorize", "/token", "/.well-known/*"]
  },
  "vars": {
    "DEFAULT_TZ": "UTC",
    "OAUTH_REDIRECT_ALLOW": "https://claude.ai,https://claude.com,http://localhost:6274"
  },
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "local-dev-placeholder" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "motion",
      "database_id": "local-dev-placeholder",
      "migrations_dir": "migrations"
    }
  ]
}
