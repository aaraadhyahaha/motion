{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "motion",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-20",
  "minify": true,
  "observability": { "enabled": true },
  "vars": { "DEFAULT_TZ": "UTC" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "motion",
      "database_id": "local-dev-placeholder",
      "migrations_dir": "migrations"
    }
  ]
}
